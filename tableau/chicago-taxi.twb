<?xml version='1.0' encoding='utf-8'?>
<workbook source-build="9.3.1" source-platform="win" version="9.3">
  <preferences>
    <preference name="ui.shelf.height" value="26" />
  </preferences>
  <datasources>
    <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" inline="true" name="textscan.taxi" version="9.3">
      <connection class="textscan" directory="sample" filename="trips.csv" separator="," header="yes" locale="en_US" charset="UTF-8">
        <relation name="trips.csv" table="[trips.csv]" type="table" />
      </connection>
      <column datatype="string" name="[trip_id]" role="dimension" type="nominal" />
      <column datatype="date" name="[trip_date]" role="dimension" type="nominal" />
      <column datatype="integer" name="[trip_hour]" role="dimension" type="nominal" />
      <column datatype="string" name="[taxi_id]" role="dimension" type="nominal" />
      <column datatype="string" name="[payment_type]" role="dimension" type="nominal" />
      <column datatype="string" name="[company]" role="dimension" type="nominal" />
      <column datatype="string" name="[pickup_community_area]" role="dimension" type="nominal" />
      <column datatype="string" name="[dropoff_community_area]" role="dimension" type="nominal" />
      <column datatype="real" name="[distance_km]" role="measure" type="quantitative" />
      <column datatype="real" name="[trip_total]" role="measure" type="quantitative" />
      <column datatype="real" name="[tips]" role="measure" type="quantitative" />
      <column datatype="real" name="[trip_seconds]" role="measure" type="quantitative" />
      <column datatype="real" name="[Average trip total]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([trip_total]) / COUNT([trip_id])" />
      </column>
      <column datatype="real" name="[Longest trip km]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX([distance_km])" />
      </column>
      <column datatype="real" name="[Shortest positive trip km]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MIN(IF [distance_km] &gt; 0 THEN [distance_km] END)" />
      </column>
      <column datatype="boolean" name="[Is longest trip]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[distance_km] = { FIXED : MAX([distance_km]) }" />
      </column>
      <column datatype="boolean" name="[Is shortest positive trip]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[distance_km] &gt; 0 AND [distance_km] = { FIXED : MIN(IF [distance_km] &gt; 0 THEN [distance_km] END) }" />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Trip count">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="string" name="[trip_id]" role="dimension" type="nominal" />
            <column-instance column="[trip_id]" derivation="Count" name="[cnt:trip_id:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[textscan.taxi].[cnt:trip_id:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="Reported totals USD">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="real" name="[trip_total]" role="measure" type="quantitative" />
            <column-instance column="[trip_total]" derivation="Sum" name="[sum:trip_total:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[textscan.taxi].[sum:trip_total:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="Average trip total USD">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="real" name="[Average trip total]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([trip_total]) / COUNT([trip_id])" />
            </column>
            <column-instance column="[Average trip total]" derivation="User" name="[usr:Average trip total:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[textscan.taxi].[usr:Average trip total:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="Daily reported totals">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="real" name="[trip_total]" role="measure" type="quantitative" />
            <column-instance column="[trip_total]" derivation="Sum" name="[sum:trip_total:qk]" pivot="key" type="quantitative" />
            <column datatype="date" name="[trip_date]" role="dimension" type="nominal" />
            <column-instance column="[trip_date]" derivation="None" name="[none:trip_date:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
          </pane>
        </panes>
        <rows>[textscan.taxi].[sum:trip_total:qk]</rows>
        <cols>[textscan.taxi].[none:trip_date:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Taxi rankings by reported total">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="real" name="[trip_total]" role="measure" type="quantitative" />
            <column-instance column="[trip_total]" derivation="Sum" name="[sum:trip_total:qk]" pivot="key" type="quantitative" />
            <column datatype="string" name="[taxi_id]" role="dimension" type="nominal" />
            <column-instance column="[taxi_id]" derivation="None" name="[none:taxi_id:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <sort class="computed" column="[textscan.taxi].[none:taxi_id:nk]" direction="DESC" using="[textscan.taxi].[sum:trip_total:qk]" />
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
          </pane>
        </panes>
        <rows>[textscan.taxi].[none:taxi_id:nk]</rows>
        <cols>[textscan.taxi].[sum:trip_total:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Trips by payment method">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="string" name="[trip_id]" role="dimension" type="nominal" />
            <column-instance column="[trip_id]" derivation="Count" name="[cnt:trip_id:qk]" pivot="key" type="quantitative" />
            <column datatype="string" name="[payment_type]" role="dimension" type="nominal" />
            <column-instance column="[payment_type]" derivation="None" name="[none:payment_type:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
          </pane>
        </panes>
        <rows>[textscan.taxi].[none:payment_type:nk]</rows>
        <cols>[textscan.taxi].[cnt:trip_id:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Demand by hour">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="string" name="[trip_id]" role="dimension" type="nominal" />
            <column-instance column="[trip_id]" derivation="Count" name="[cnt:trip_id:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[trip_hour]" role="dimension" type="nominal" />
            <column-instance column="[trip_hour]" derivation="None" name="[none:trip_hour:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
          </pane>
        </panes>
        <rows>[textscan.taxi].[none:trip_hour:nk]</rows>
        <cols>[textscan.taxi].[cnt:trip_id:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Longest trip km">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="real" name="[Longest trip km]" role="measure" type="quantitative">
              <calculation class="tableau" formula="MAX([distance_km])" />
            </column>
            <column-instance column="[Longest trip km]" derivation="User" name="[usr:Longest trip km:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[textscan.taxi].[usr:Longest trip km:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="Shortest positive trip km">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="real" name="[Shortest positive trip km]" role="measure" type="quantitative">
              <calculation class="tableau" formula="MIN(IF [distance_km] &gt; 0 THEN [distance_km] END)" />
            </column>
            <column-instance column="[Shortest positive trip km]" derivation="User" name="[usr:Shortest positive trip km:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[textscan.taxi].[usr:Shortest positive trip km:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="Longest trip IDs">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="real" name="[distance_km]" role="measure" type="quantitative" />
            <column-instance column="[distance_km]" derivation="Max" name="[max:distance_km:qk]" pivot="key" type="quantitative" />
            <column datatype="string" name="[trip_id]" role="dimension" type="nominal" />
            <column-instance column="[trip_id]" derivation="None" name="[none:trip_id:nk]" pivot="key" type="nominal" />
            <column datatype="boolean" name="[Is longest trip]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[distance_km] = { FIXED : MAX([distance_km]) }" />
            </column>
            <column-instance column="[Is longest trip]" derivation="None" name="[none:Is longest trip:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[textscan.taxi].[none:Is longest trip:nk]">
            <groupfilter function="member" level="[none:Is longest trip:nk]" member="true" />
          </filter>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
          </pane>
        </panes>
        <rows>[textscan.taxi].[none:trip_id:nk]</rows>
        <cols>[textscan.taxi].[max:distance_km:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Shortest positive trip IDs">
      <table>
        <view>
          <datasources>
            <datasource caption="Chicago Taxi Trips (SYNTHETIC SAMPLE)" name="textscan.taxi" />
          </datasources>
          <datasource-dependencies datasource="textscan.taxi">
            <column datatype="real" name="[distance_km]" role="measure" type="quantitative" />
            <column-instance column="[distance_km]" derivation="Min" name="[min:distance_km:qk]" pivot="key" type="quantitative" />
            <column datatype="string" name="[trip_id]" role="dimension" type="nominal" />
            <column-instance column="[trip_id]" derivation="None" name="[none:trip_id:nk]" pivot="key" type="nominal" />
            <column datatype="boolean" name="[Is shortest positive trip]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[distance_km] &gt; 0 AND [distance_km] = { FIXED : MIN(IF [distance_km] &gt; 0 THEN [distance_km] END) }" />
            </column>
            <column-instance column="[Is shortest positive trip]" derivation="None" name="[none:Is shortest positive trip:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[textscan.taxi].[none:Is shortest positive trip:nk]">
            <groupfilter function="member" level="[none:Is shortest positive trip:nk]" member="true" />
          </filter>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
          </pane>
        </panes>
        <rows>[textscan.taxi].[none:trip_id:nk]</rows>
        <cols>[textscan.taxi].[min:distance_km:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <windows source-height="30">
    <window class="worksheet" name="Trip count" />
    <window class="worksheet" name="Reported totals USD" />
    <window class="worksheet" name="Average trip total USD" />
    <window class="worksheet" name="Daily reported totals" />
    <window class="worksheet" name="Taxi rankings by reported total" />
    <window class="worksheet" name="Trips by payment method" />
